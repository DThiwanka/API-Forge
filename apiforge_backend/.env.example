NODE_ENV=development
# ==============================================================================
# APIForge Backend Environment Configuration Template
# Copy this file to .env and provide appropriate values for your environment.
# NEVER commit real credentials, passwords, or production secrets to Git.
# ==============================================================================

# Node Environment: 'development' | 'test' | 'production'
NODE_ENV=production

# Server Port
PORT=5000
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/apiforge"
CLIENT_URL=http://localhost:5173

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
# Primary Database Connection String (MySQL 8.0+)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://apiforge_user:replace_with_strong_password@localhost:3306/apiforge"

# Allowed Frontend Client Origin(s) for CORS and Cookies
# Multiple origins can be comma-separated: https://app.example.com,https://staging.example.com
CLIENT_URL=https://app.example.com

# ------------------------------------------------------------------------------
# JWT & Authentication Secrets
# In production, both secrets must be at least 32 characters of random entropy
# and must NOT be identical. Generate with: openssl rand -base64 32
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_different_cryptographically_secure_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Request Execution Engine Configuration
# ------------------------------------------------------------------------------
# Cookie Configuration
# COOKIE_SECURE: Set to true when serving over HTTPS (default in production)
# COOKIE_SAME_SITE: 'lax' (same-site or top-level navigation) or 'none' (cross-site HTTPS)
# COOKIE_DOMAIN: Optional cookie domain (e.g., .example.com) for multi-subdomain auth
# ------------------------------------------------------------------------------
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.example.com

# ------------------------------------------------------------------------------
# Reverse Proxy & Networking
# Set to 'true' or trusted hop count/IPs when behind Nginx, Caddy, Cloudflare, AWS ALB
# ------------------------------------------------------------------------------
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# Request Execution Engine & SSRF Safety
# ALLOW_LOCAL_TARGETS: Must remain false in production to prevent SSRF
# ------------------------------------------------------------------------------
REQUEST_TIMEOUT_MS=30000
MAX_REQUEST_TIMEOUT_MS=120000
MAX_RESPONSE_SIZE_BYTES=10485760
ALLOW_LOCAL_TARGETS=false

# ------------------------------------------------------------------------------
# Rate Limiting (In-Memory Sliding Window)
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_EXEC_MAX=120

# ------------------------------------------------------------------------------
# Browser Space (Headless Chromium / Playwright)
# ------------------------------------------------------------------------------
BROWSER_MAX_SESSIONS_PER_WORKSPACE=5
BROWSER_MAX_TABS_PER_SESSION=10
BROWSER_NAVIGATION_TIMEOUT_MS=15000
BROWSER_SESSION_INACTIVITY_TIMEOUT_MS=1800000
BROWSER_CLEANUP_INTERVAL_MS=300000
BROWSER_MAX_NETWORK_EVENTS_PER_TAB=500

# ------------------------------------------------------------------------------
# Collaboration & Invitations
# ------------------------------------------------------------------------------
INVITATION_EXPIRATION_HOURS=168

# ------------------------------------------------------------------------------
# Logging & Graceful Shutdown
# LOG_LEVEL: 'debug' | 'info' | 'warn' | 'error'
# ------------------------------------------------------------------------------
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
