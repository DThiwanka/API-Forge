# Example Environment Variables
VITE_API_BASE_URL=http://localhost:5000/api
VITE_WS_URL=ws://localhost:5000/ws
# ==============================================================================
# APIForge Frontend Environment Configuration Template
# Copy this file to .env or .env.production.
# Notice: Any variable prefixed with VITE_ will be bundled and visible publicly.
# DO NOT place passwords, private keys, or backend secrets here!
# ==============================================================================

# Backend API Base URL (must point to /api mount)
# In production, point to your API domain, e.g., https://api.example.com/api
VITE_API_BASE_URL=https://api.example.com/api

# WebSocket Realtime Collaboration URL
# In production with HTTPS, use wss:// scheme, e.g., wss://api.example.com/ws
VITE_WS_URL=wss://api.example.com/ws
